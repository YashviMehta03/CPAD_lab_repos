{
  "name": "campussphere-backend",
  "version": "1.0.0",
  "description": "CampusSphere API: Express + PostgreSQL (Supabase) with JWT role-based auth",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "db:reset": "node scripts/migrate.js && node scripts/seed.js",
    "test": "node scripts/smoke.js",
    "link-login": "node scripts/link-login.js",
    "prof-logins": "node scripts/prof-logins.js"
  },
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
