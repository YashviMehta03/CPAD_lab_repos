# Copy this file to .env and fill in the values.

# Supabase > Project Settings > Database > Connection string (URI).
# The session pooler (port 5432) or direct connection both work.
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Any long random string. Used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Supabase > Project Settings > API. Required: Supabase Auth handles sign up / login
# (Authentication > Users in the dashboard), and Storage holds helpdesk photos.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=helpdesk

PORT=4000

# Optional, for demos: freeze the campus clock (IST wall time), e.g. 2026-11-16T10:45
# Leave empty to use the real time.
DEMO_NOW=
